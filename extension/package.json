{
  "name": "lamia-ide",
  "displayName": "Lamia Studio",
  "description": "IDE for the Lamia programming language with chat, syntax highlighting, and code execution",
  "version": "0.1.0",
  "publisher": "lamia",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lamia",
        "aliases": [
          "Lamia",
          "lamia"
        ],
        "extensions": [
          ".lm"
        ],
        "configuration": "./language-configuration-lm.json",
        "icon": {
          "light": "./icons/lm.svg",
          "dark": "./icons/lm.svg"
        }
      },
      {
        "id": "lamia-prompt",
        "aliases": [
          "Lamia Prompt",
          "Human Prompt"
        ],
        "extensions": [
          ".hu"
        ],
        "configuration": "./language-configuration-hu.json"
      }
    ],
    "grammars": [
      {
        "language": "lamia",
        "scopeName": "source.lamia",
        "path": "./syntaxes/lm.tmLanguage.json"
      },
      {
        "language": "lamia-prompt",
        "scopeName": "text.lamia.prompt",
        "path": "./syntaxes/hu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lamia",
        "path": "./lamia.code-snippets"
      }
    ],
    "taskDefinitions": [
      {
        "type": "lamia",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .lm file to run"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "lamia.run",
        "title": "Lamia: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "lamia.stop",
        "title": "Lamia: Stop Running File",
        "icon": "$(debug-stop)"
      },
      {
        "command": "lamia.debug",
        "title": "Lamia: Debug Current File",
        "icon": "$(bug)"
      },
      {
        "command": "lamia.openChat",
        "title": "Lamia: Open Chat Panel"
      },
      {
        "command": "lamia.trackCopy",
        "title": "Lamia: Track Copied Snippet"
      },
      {
        "command": "lamia.copySystemInfo",
        "title": "Lamia: Copy System Info for Bug Report"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "lamia.run",
          "when": "resourceExtname == .lm",
          "group": "navigation"
        },
        {
          "command": "lamia.debug",
          "when": "resourceExtname == .lm",
          "group": "2_debug"
        }
      ],
      "editor/title": [
        {
          "command": "lamia.stop",
          "when": "resourceExtname == .lm && lamia.isRunning",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "lamia.run",
          "when": "resourceExtname == .lm",
          "group": "navigation"
        },
        {
          "command": "lamia.debug",
          "when": "resourceExtname == .lm",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lamia.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceExtname == .lm"
      },
      {
        "command": "lamia.stop",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "lamia.isRunning"
      },
      {
        "command": "lamia.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "lamia.trackCopy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "lamia-chat-container",
          "title": "Lamia Chat",
          "icon": "./icons/chat.svg"
        }
      ]
    },
    "views": {
      "lamia-chat-container": [
        {
          "type": "webview",
          "id": "lamia.chatView",
          "name": "Chat"
        }
      ]
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.function.agent.lamia",
            "settings": {
              "foreground": "#DCDCAA",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.function.call.python",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "support.function.pydantic.python",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "support.class.pydantic.python",
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "scope": "storage.type.lamia",
            "settings": {
              "foreground": "#569CD6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.type.model.lamia",
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "scope": "keyword.operator.arrow.lamia",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "variable.other.readwrite.lamia",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "entity.name.tag.file-reference.lamia",
            "settings": {
              "foreground": "#CE9178",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "meta.decorator.python",
            "settings": {
              "foreground": "#DCDCAA"
            }
          }
        ]
      }
    },
    "breakpoints": [
      {
        "language": "lamia"
      }
    ],
    "debuggers": [
      {
        "type": "lamia",
        "languages": [
          "lamia"
        ],
        "label": "Lamia Debug",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path of the .lm file to debug",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the program",
                "default": "${fileDirname}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first executable line",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lamia",
            "request": "launch",
            "name": "Debug Lamia File",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Lamia: Debug Current File",
            "description": "Debug the current .lm file with step-by-step execution",
            "body": {
              "type": "lamia",
              "request": "launch",
              "name": "Debug Lamia File",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Lamia",
      "properties": {
        "lamia.cliPath": {
          "type": "string",
          "default": "lamia",
          "description": "Path to the lamia CLI executable. Defaults to 'lamia' (must be on PATH)."
        },
        "lamia.chat.timeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "Milliseconds to wait for a lamia CLI response before timing out. Set to 0 to disable timeout."
        },
        "lamia.mcp.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP server configurations. Managed via the chat settings panel (gear icon > MCP Servers)."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5"
  }
}
