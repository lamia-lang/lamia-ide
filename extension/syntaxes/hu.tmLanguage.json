{
  "name": "Lamia Prompt",
  "scopeName": "text.lamia.prompt",
  "fileTypes": ["hu"],
  "patterns": [
    { "include": "#file-reference" },
    { "include": "#variable" },
    { "include": "#heading" },
    { "include": "#list-item" },
    { "include": "#emphasis" },
    { "include": "#code-block" },
    { "include": "#code-inline" }
  ],
  "repository": {
    "file-reference": {
      "comment": "File context references: {@resume.pdf}, {@config}",
      "match": "(\\{)(@[^}]+)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.variable.begin.lamia" },
        "2": { "name": "entity.name.tag.file-reference.lamia" },
        "3": { "name": "punctuation.definition.variable.end.lamia" }
      }
    },
    "variable": {
      "comment": "Template variables: {prd_content}, {specs}",
      "match": "(\\{)([a-z_][a-z0-9_]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.variable.begin.lamia" },
        "2": { "name": "variable.other.readwrite.lamia" },
        "3": { "name": "punctuation.definition.variable.end.lamia" }
      }
    },
    "heading": {
      "match": "^(#{1,6})\\s+(.+)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.markdown" },
        "2": { "name": "markup.heading.markdown" }
      }
    },
    "list-item": {
      "match": "^\\s*(-|\\*|\\d+\\.)\\s+",
      "name": "punctuation.definition.list.markdown"
    },
    "emphasis": {
      "match": "\\*\\*([^*]+)\\*\\*",
      "name": "markup.bold.markdown"
    },
    "code-block": {
      "begin": "^\\s*```",
      "end": "^\\s*```",
      "name": "markup.fenced_code.block.markdown"
    },
    "code-inline": {
      "match": "`([^`]+)`",
      "name": "markup.inline.raw.string.markdown"
    }
  }
}
