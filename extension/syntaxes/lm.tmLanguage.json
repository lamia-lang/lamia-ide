{
  "name": "Lamia",
  "scopeName": "source.lamia",
  "fileTypes": ["lm"],
  "patterns": [
    { "include": "#lamia-call" },
    { "include": "#lamia-arrow" },
    { "include": "#lamia-arrow-general" },
    { "include": "#docstring" },
    { "include": "#comment" },
    { "include": "#fstring-triple-double" },
    { "include": "#fstring-triple-single" },
    { "include": "#fstring-double" },
    { "include": "#fstring-single" },
    { "include": "#string-triple-double" },
    { "include": "#string-triple-single" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#pydantic" },
    { "include": "#function-def" },
    { "include": "#class-def" },
    { "include": "#decorator" },
    { "include": "#function-call" },
    { "include": "#type-hint" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "lamia-call": {
      "comment": "Lamia agent calls: agent_name(args) -> JSON[Model]",
      "match": "\\b([a-z_][a-z0-9_]*)\\s*(\\()(.+?)(\\))\\s*(->)\\s*(JSON)(\\[)([A-Z][a-zA-Z0-9_]*)(\\])",
      "captures": {
        "1": { "name": "entity.name.function.agent.lamia" },
        "2": { "name": "punctuation.paren.open.lamia" },
        "3": { "name": "variable.parameter.lamia", "patterns": [
          { "include": "#lamia-kwarg" },
          { "include": "#string-double" },
          { "include": "#string-single" }
        ]},
        "4": { "name": "punctuation.paren.close.lamia" },
        "5": { "name": "keyword.operator.arrow.lamia" },
        "6": { "name": "storage.type.json.lamia" },
        "7": { "name": "punctuation.bracket.open.lamia" },
        "8": { "name": "entity.name.type.model.lamia" },
        "9": { "name": "punctuation.bracket.close.lamia" }
      }
    },
    "lamia-arrow": {
      "comment": "Lamia arrow with typed model: -> JSON[ModelName]",
      "match": "(->)\\s*(JSON|CSV)(\\[)([A-Z][a-zA-Z0-9_]*)(\\])",
      "captures": {
        "1": { "name": "keyword.operator.arrow.lamia" },
        "2": { "name": "storage.type.lamia" },
        "3": { "name": "punctuation.bracket.open.lamia" },
        "4": { "name": "entity.name.type.model.lamia" },
        "5": { "name": "punctuation.bracket.close.lamia" }
      }
    },
    "lamia-arrow-general": {
      "comment": "Lamia arrow with return type: -> HTML, -> TEXT, -> File(...), etc.",
      "match": "(->)\\s*(JSON|HTML|TEXT|XML|YAML|CSV|Markdown|File)\\b",
      "captures": {
        "1": { "name": "keyword.operator.arrow.lamia" },
        "2": { "name": "storage.type.lamia" }
      }
    },
    "lamia-kwarg": {
      "match": "\\b([a-z_][a-z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "variable.parameter.function.lamia" },
        "2": { "name": "keyword.operator.assignment.python" }
      }
    },
    "pydantic": {
      "patterns": [
        {
          "comment": "Pydantic Field() call",
          "match": "\\b(Field)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.pydantic.python" }
          }
        },
        {
          "comment": "Pydantic/dataclass model bases and validators",
          "match": "\\b(BaseModel|BaseSettings|ConfigDict|field_validator|model_validator|validator|computed_field)\\b",
          "name": "support.class.pydantic.python"
        }
      ]
    },
    "function-call": {
      "comment": "General function/method calls: foo(, bar.baz(",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.python" }
      }
    },
    "docstring": {
      "begin": "^\\s*(\"\"\"|''')",
      "end": "\\1",
      "name": "comment.block.documentation.python"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.python"
    },
    "fstring-triple-double": {
      "begin": "([fF])(\"\"\")",
      "end": "(\"\"\")",
      "beginCaptures": {
        "1": { "name": "storage.type.string.python" },
        "2": { "name": "punctuation.definition.string.begin.python" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "name": "string.quoted.triple.double.python",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "fstring-triple-single": {
      "begin": "([fF])(''')",
      "end": "(''')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.python" },
        "2": { "name": "punctuation.definition.string.begin.python" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "name": "string.quoted.triple.single.python",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "fstring-double": {
      "begin": "([fF])(\")",
      "end": "(\")",
      "beginCaptures": {
        "1": { "name": "storage.type.string.python" },
        "2": { "name": "punctuation.definition.string.begin.python" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "name": "string.quoted.double.python",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "fstring-single": {
      "begin": "([fF])(')",
      "end": "(')",
      "beginCaptures": {
        "1": { "name": "storage.type.string.python" },
        "2": { "name": "punctuation.definition.string.begin.python" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "name": "string.quoted.single.python",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "fstring-interpolation": {
      "begin": "(\\{)(?!\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.interpolation.begin.python" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.interpolation.end.python" }
      },
      "name": "meta.interpolation.python",
      "patterns": [
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#constants" },
        { "include": "#number" },
        { "include": "#operator" },
        { "include": "#string-double" },
        { "include": "#string-single" },
        { "include": "#function-call" }
      ]
    },
    "string-triple-double": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.double.python"
    },
    "string-triple-single": {
      "begin": "'''",
      "end": "'''",
      "name": "string.quoted.triple.single.python"
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.python",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "string-single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.python",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.python" }
      ]
    },
    "keywords": {
      "match": "\\b(import|from|as|def|class|return|if|elif|else|for|while|try|except|finally|with|raise|pass|break|continue|yield|async|await|and|or|not|in|is|lambda|assert|del|global|nonlocal)\\b",
      "name": "keyword.control.python"
    },
    "builtins": {
      "match": "\\b(print|len|range|str|int|float|list|dict|tuple|set|bool|isinstance|type|super|enumerate|zip|map|filter|sorted|open|any|all|sum|min|max|abs|round|hasattr|getattr|setattr)\\b",
      "name": "support.function.builtin.python"
    },
    "constants": {
      "match": "\\b(True|False|None)\\b",
      "name": "constant.language.python"
    },
    "function-def": {
      "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.python" },
        "2": { "name": "entity.name.function.python" }
      }
    },
    "class-def": {
      "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.python" },
        "2": { "name": "entity.name.class.python" }
      }
    },
    "decorator": {
      "match": "^\\s*(@[a-zA-Z_][a-zA-Z0-9_.]*)",
      "name": "meta.decorator.python"
    },
    "type-hint": {
      "match": "\\b(str|int|float|bool|list|dict|tuple|set|Path|Optional|Union|Type|Any|List|Dict|Tuple|Set|Callable|BaseModel)\\b",
      "name": "support.type.python"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.python"
    },
    "operator": {
      "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|/|%|\\*\\*|//|=|\\+=|-=|\\*=|/=)",
      "name": "keyword.operator.python"
    }
  }
}
